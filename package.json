{
  "name": "blessed-hope-ministry-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply blessed-hope-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply blessed-hope-db --remote",
    "db:seed:local": "wrangler d1 execute blessed-hope-db --local --file=seed.sql",
    "db:seed:remote": "wrangler d1 execute blessed-hope-db --remote --file=seed.sql"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "hono": "^4.13.22",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
