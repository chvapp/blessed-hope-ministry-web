{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blessed-hope-ministry",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Pages, /api/* and /media/* hit the Worker first (it injects per-page SEO tags into the
  // HTML); built files, images and icons are served straight from Cloudflare's edge.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/images/*",
      "!/icons/*",
      "!/favicon.svg",
      "!/og-image.jpg",
      "!/site.webmanifest"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blessed-hope-db",
      "database_id": "53c1f0ec-5cfb-493e-ad37-b62a070d371c",
      "migrations_dir": "migrations"
    }
  ],

  // Admin image uploads go to Amazon S3 (bucket and region under "vars", keys as secrets). To use Cloudflare R2
  // instead, create a bucket and add: "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "..." }]

  // Brute-force protection for admin sign-in (10 attempts per minute per IP).
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],

  // Sends queued WhatsApp broadcast messages every minute.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "APP_URL": "https://blessed-hope-ministry.chvapp1.workers.dev",
    "DEFAULT_COUNTRY_CODE": "234",
    "BROADCAST_BATCH_SIZE": "40",
    "WHATSAPP_API_VERSION": "v23.0",
    "PAYSTACK_PUBLIC_KEY": "",
    // Admin image uploads land in <S3_BUCKET>/blessed-hope-media/
    "S3_BUCKET": "chv-images",
    "S3_REGION": "eu-west-1"
  }
  // Secrets (set with `bunx wrangler secret put NAME`, or in .dev.vars locally):
  //   SESSION_SECRET, ADMIN_SETUP_TOKEN, PAYSTACK_SECRET_KEY,
  //   WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID,
  //   WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN,
  //   S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
}
